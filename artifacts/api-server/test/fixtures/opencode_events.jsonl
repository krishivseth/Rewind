data: {"id":"evt_0eac0cbc5001bWOQh4OQws4dyt","type":"message.part.updated","properties":{"sessionID":"ses_f153f3440ffejIpyMNn5pnBjf3","part":{"type":"tool","tool":"read","callID":"call_4345edc3e7be41a4ad5999fc","state":{"status":"completed","input":{"filePath":"/tmp/ocproj/csv_stats.py"},"output":"<path>/tmp/ocproj/csv_stats.py</path>\n<type>file</type>\n<content>\n1: \"\"\"csv-stats: read a CSV file and print count/min/max/mean for every numeric column.\"\"\"\n2: import csv\n3: import sys\n4: \n5: \n6: def load_rows(path):\n7:     \"\"\"Return the data rows (as dicts) and the header from a CSV file.\"\"\"\n8:     with open(path, newline=\"\") as f:\n9:         reader = csv.DictReader(f)\n10:         rows = list(reader)\n11:         return reader.fieldnames or [], rows\n12: \n13: \n14: def row_count(rows):\n15:     \"\"\"Number of data rows in the file (header excluded).\"\"\"\n16:     return len(rows) + 1\n17: \n18: \n19: def column_values(rows, column):\n20:     \"\"\"Numeric values for a column. Empty cells should be skipped, not counted.\"\"\"\n21:     values = []\n22:     for row in rows:\n23:         cell = row.get(column, \"\")\n24:         values.append(float(cell))\n25:     return values\n26: \n27: \n28: def column_stats(rows, column):\n29:     values = column_values(rows, column)\n30:     if not values:\n31:         return {\"count\": 0, \"min\": None, \"max\": None, \"mean\": None}\n32:     return {\n33:         \"count\": len(values),\n34:         \"min\": min(values),\n35:         \"max\": max(values),\n36:         \"mean\": sum(values) / len(values),\n37:     }\n38: \n39: \n40: def format_stats(name, stats):\n41:     if stats[\"count\"] == 0:\n42:         return f\"{name}: no numeric values\"\n43:     return (\n44:         f\"{name}: count={stats['count']} min={stats['min']:g} \"\n45:         f\"max={stats['max']:g} mean={stats['mean']:.3f}\"\n46:     )\n47: \n48: \n49: def main(argv=None):\n50:     argv = sys.argv[1:] if argv is None else argv\n51:     if len(argv) != 1:\n52:         print(\"usage: csv_stats.py FILE.csv\", file=sys.stderr)\n53:         return 2\n54:     header, rows = load_rows(argv[0])\n55:     print(f\"rows: {row_count(rows)}\")\n56:     for col in header:\n57:         try:\n58:             print(format_stats(col, column_stats(rows, col)))\n59:         except ValueError:\n60:             print(f\"{col}: not numeric\")\n61:     return 0\n62: \n63: \n64: if __name__ == \"__main__\":\n65:     sys.exit(main())\n\n(End of file - total 65 lines)\n</content>","metadata":{"preview":"\"\"\"csv-stats: read a CSV file and print count/min/max/mean for every numeric column.\"\"\"\nimport csv\nimport sys\n\n\ndef load_rows(path):\n    \"\"\"Return the data rows (as dicts) and the header from a CSV file.\"\"\"\n    with open(path, newline=\"\") as f:\n        reader = csv.DictReader(f)\n        rows = list(reader)\n        return reader.fieldnames or [], rows\n\n\ndef row_count(rows):\n    \"\"\"Number of data rows in the file (header excluded).\"\"\"\n    return len(rows) + 1\n\n\ndef column_values(rows, column):\n    \"\"\"Numeric values for a column. Empty cells should be skipped, not counted.\"\"\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/tmp/ocproj/csv_stats.py","text":"\"\"\"csv-stats: read a CSV file and print count/min/max/mean for every numeric column.\"\"\"\nimport csv\nimport sys\n\n\ndef load_rows(path):\n    \"\"\"Return the data rows (as dicts) and the header from a CSV file.\"\"\"\n    with open(path, newline=\"\") as f:\n        reader = csv.DictReader(f)\n        rows = list(reader)\n        return reader.fieldnames or [], rows\n\n\ndef row_count(rows):\n    \"\"\"Number of data rows in the file (header excluded).\"\"\"\n    return len(rows) + 1\n\n\ndef column_values(rows, column):\n    \"\"\"Numeric values for a column. Empty cells should be skipped, not counted.\"\"\"\n    values = []\n    for row in rows:\n        cell = row.get(column, \"\")\n        values.append(float(cell))\n    return values\n\n\ndef column_stats(rows, column):\n    values = column_values(rows, column)\n    if not values:\n        return {\"count\": 0, \"min\": None, \"max\": None, \"mean\": None}\n    return {\n        \"count\": len(values),\n        \"min\": min(values),\n        \"max\": max(values),\n        \"mean\": sum(values) / len(values),\n    }\n\n\ndef format_stats(name, stats):\n    if stats[\"count\"] == 0:\n        return f\"{name}: no numeric values\"\n    return (\n        f\"{name}: count={stats['count']} min={stats['min']:g} \"\n        f\"max={stats['max']:g} mean={stats['mean']:.3f}\"\n    )\n\n\ndef main(argv=None):\n    argv = sys.argv[1:] if argv is None else argv\n    if len(argv) != 1:\n        print(\"usage: csv_stats.py FILE.csv\", file=sys.stderr)\n        return 2\n    header, rows = load_rows(argv[0])\n    print(f\"rows: {row_count(rows)}\")\n    for col in header:\n        try:\n            print(format_stats(col, column_stats(rows, col)))\n        except ValueError:\n            print(f\"{col}: not numeric\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())","lineStart":1,"lineEnd":65,"totalLines":65,"truncated":false}},"title":"csv_stats.py","time":{"start":1790644843440,"end":1790644843446}},"id":"prt_0eac0cbc5001zsF02oPzHCIcfY","sessionID":"ses_f153f3440ffejIpyMNn5pnBjf3","messageID":"msg_0eac0cbc20025J7No7tB2XZxwv"},"time":1790644898757}}

