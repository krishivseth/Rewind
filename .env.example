# Local development. Replit and Docker inject these as real environment variables instead.
DATABASE_URL=postgresql://postgres:rewind@localhost:5432/rewind
OPENROUTER_API_KEY=sk-or-...
REWIND_ACCESS_KEY=change-me
DATA_DIR=./data
# Ports for `pnpm dev`
# API_PORT=8080
# WEB_PORT=5173
# Limits (defaults shown)
# MAX_MODEL_CALLS=30
# MAX_TOTAL_TOKENS_PER_BRANCH=150000
# MAX_TOTAL_TOKENS_PER_SESSION=300000
# REWIND_DAILY_TOKEN_CAP=2000000
# MAX_CONCURRENT_BRANCHES=4
# REWIND_READ_ONLY=0
# Sign in with GitHub (REWIND_PUBLIC_WRITES=signed_in). Register the callback URL for each host.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SESSION_SECRET=
