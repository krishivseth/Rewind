# Copy to .env; the API server and the seed script read it from the repository root.
DATABASE_URL=postgresql://postgres:rewind@localhost:5432/rewind
OPENROUTER_API_KEY=sk-or-...
# Any long random string; needed for every write. Generate one: openssl rand -hex 16
REWIND_ACCESS_KEY=

# Where bundles, snapshots and the sandbox venv live. Use a persistent path, not /tmp.
DATA_DIR=./data

# off: every write needs the key. cheap: visitors may run the cheap model. signed_in: GitHub sign-in required.
REWIND_PUBLIC_WRITES=off
# 1 makes the deployment a read-only showcase
REWIND_READ_ONLY=0

# OpenCode runner (recorded sessions). The agent gets a real shell: see SECURITY.md.
# Projects must live under this directory; the server checks real paths.
OPENCODE_PROJECTS_ROOT=./projects
# OPENCODE_BIN=opencode
# OPENCODE_PORT_BASE=4096

# Security classifier (Jev via OpenRouter)
# JEV_MODEL=typesafe/jev-1.13
# CLASSIFY_MAX_CHARS=24000
# 1 enables POST /api/classify for the inline guard plugin (.opencode/plugins/rewind.ts)
# REWIND_INLINE_GUARD=0

# GitHub sign-in (optional; only for REWIND_PUBLIC_WRITES=signed_in)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SESSION_SECRET=
