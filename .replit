modules = ["nodejs-24", "postgresql-16", "python-base-3.12"]

[deployment]
router = "application"
deploymentTarget = "vm"
# Reserved VM, not autoscale: agent branches run for minutes inside the API process and must not be
# killed between requests or scaled to zero.

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-fb4fc133-5200-43b2-87a6-5665b87b9f32"
